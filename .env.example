# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Admin area (/admin).
# ADMIN_PASSWORD is the only credential: there is no user table, and a missing
# value leaves the admin inaccessible rather than open.
# ADMIN_SESSION_SECRET signs the session cookie. Set it separately from the
# password so the session key can be rotated without changing the password.
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="change-me-too"