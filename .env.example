# Copy to `.env.local` for local development, or `.env` for production. Never commit the filled file.

# --- Container Image & Networking (Self-hosted Docker) ---
APP_IMAGE=registry.hakiware.com/dentora:latest
PORT=3000

# --- Public Site URL ---
# Drives metadataBase, canonicals, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- PostgreSQL Database ---
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dental_discovery?schema=public"

# --- SerpApi Google Maps Sync ---
# Free tier: 250 searches/month, 50 throughput/hour.
SERPAPI_API_KEY=

# --- Admin Area Authentication (/admin) ---
# ADMIN_PASSWORD is the only credential: there is no user table, and a missing
# value leaves the admin inaccessible rather than open.
# ADMIN_SESSION_SECRET signs the session cookie; rotate it without changing the password.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Kapso WhatsApp Integration (@kapso/whatsapp-cloud-api) ---
# The base URL is the Kapso proxy, not Meta's graph.facebook.com, which unlocks
# template sends plus Kapso's storage/query APIs. Templates must be created and
# approved in the Kapso dashboard before they can be sent.
KAPSO_BASE_URL=https://app.kapso.ai/api/meta/
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# Shared secret Kapso appends as ?token= when calling the delivery-receipt
# webhook. Without it the webhook fails closed and delivery counts stay empty.
KAPSO_WEBHOOK_SECRET=

# --- Clinic Outreach Campaigns ---
# Keep CAMPAIGN_DRY_RUN=true until the rendered messages have been reviewed;
# a live run writes SENT rows to clinic_outreach.
CAMPAIGN_DRY_RUN=true
CAMPAIGN_TEMPLATE_KEY=dental-app-promo-fr
CAMPAIGN_MAX_PER_RUN=25
CAMPAIGN_DELAY_MS=2000
# The campaign is started by hand from /admin/jobs, never on a timer: there is
# no schedule key here on purpose.

# --- Email Delivery (Mailtrap or SMTP) ---
# For the clinic OTP login. Set MAILTRAP_API_TOKEN for the HTTP API, or
# MAILTRAP_HOST/USERNAME/PASSWORD to send over SMTP instead. With neither set,
# request-otp returns the code in the response so local development still works.
EMAIL_PROVIDER=mailtrap
EMAIL_FROM=no-reply@dentora.ma
EMAIL_FROM_NAME=Dentora
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=

# --- Clinic OTP Login ---
# Signs the dd_clinic_session cookie; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLINIC_SESSION_SECRET=
CLINIC_OTP_TTL_MIN=10
CLINIC_OTP_MAX_ATTEMPTS=5

# --- Clinic Sync (started from /admin/jobs) ---
# No scheduler: the SerpApi sync is a manual admin action so quota is spent only
# when an operator decides to. Caps for that run live in the admin form.
SERAPI_MAX_SEARCHES=10
SERAPI_DELAY_MS=1500
# Quota guards enforced by lib/services/serpapi-core.mjs before a search is spent.
SERPAPI_MONTHLY_BUDGET=250
SERPAPI_HOURLY_LIMIT=50