// use prisma-8

model City {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  nameAr       String
  regionFr     String
  regionAr     String
  lat          Float
  lng          Float
  populationFr String
  populationAr String
  seoIntroFr   String
  seoIntroAr   String
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    temporal.updatedAt()

  @@map("cities")
}

model Specialty {
  id            String   @id @default(uuid())
  slug          String   @unique
  nameFr        String
  nameAr        String
  descriptionFr String
  descriptionAr String
  icon          String
  createdAt     DateTime @default(now())

  @@map("specialties")
}

model Clinic {
  id             String   @id @default(uuid())
  slug           String   @unique
  // Nullable: seed rows and manually imported clinics have no Google place id.
  // A unique index over many NULLs is still satisfied in Postgres, so relaxing
  // NOT NULL does not weaken the dedupe guarantee for real SerpApi rows.
  googlePlaceId  String?  @unique
  name           String
  nameAr         String
  citySlug       String
  city           City     @relation(fields: [citySlug], references: [slug], onDelete: Restrict)
  specialties    ClinicSpecialty[]
  neighborhoodFr String
  neighborhoodAr String
  addressFr      String
  addressAr      String
  phone          String?
  phoneHref      String?
  whatsapp       String?
  website        String?
  email          String?
  emailSource    String?
  outreach       ClinicOutreach[]
  rating         Float    @default(5.0)
  reviewCount    Int      @default(0)
  verified       Boolean  @default(false)
  claimed        Boolean  @default(false)
  usesApp        Boolean  @default(false)
  descriptionFr  String
  descriptionAr  String
  lat            Float
  lng            Float
  hours          Json
  lastSyncedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()

  @@index([citySlug])
  @@index([rating])
  // NOT unique on purpose. A group practice publishes one switchboard number that
  // Google attaches to several distinct place entries, one per practitioner, so
  // (citySlug, phone) is not an identity key here: 11 of the 16 duplicate groups
  // in production are unrelated clinics or separate dentists at one practice.
  // Enforcing it merged distinct clinics or rejected valid inserts.
  // Identity is googlePlaceId above, with the deterministic
  // place_id -> data_id -> name/city/address hash fallback covering rows that
  // Google returns without an id.
  @@index([citySlug, phone])
  @@map("clinics")
}

model ClinicSpecialty {
  clinicId    String
  specialtyId String
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([clinicId, specialtyId])
  @@map("clinic_specialties")
}

model Lead {
  id          String   @id @default(uuid())
  type        String   // APP_DEMO, WEBSITE_QUOTE, CLINIC_CLAIM, CONTACT
  clinicId    String?
  clinic      Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  planKey     String?
  clinicName  String?
  name        String
  email       String
  phone       String?
  city        String?
  message     String?
  locale      String   @default("fr")
  status      String   @default("NEW") // NEW, CONTACTED, CONVERTED, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@index([type])
  @@index([status])
  @@map("leads")
}

model ClinicOutreach {
  id         String    @id @default(uuid())
  clinicId   String
  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  channel    String    // WHATSAPP, EMAIL
  status     String    @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED, REPLIED, OPTED_OUT
  template   String?
  note       String?
  // Kapso/Cloud API message id, needed to reconcile delivery webhooks back to
  // the clinic. Null for rows written before tracking existed.
  providerMessageId String?
  sentAt     DateTime?
  deliveredAt DateTime?
  failedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  temporal.updatedAt()

  @@unique([clinicId, channel])
  @@index([status])
  @@index([providerMessageId])
  @@map("clinic_outreach")
}

// A single admin-triggered batch of work (WhatsApp campaign, SerpApi sync).
// The admin UI polls the counters to show progress, so a run outlives the
// request that started it.
model JobRun {
  id          String    @id @default(uuid())
  kind        String    // WHATSAPP_CAMPAIGN, SERPAPI_SYNC
  status      String    @default("RUNNING") // RUNNING, COMPLETED, FAILED
  requestedBy String?
  params      Json?
  errors      Json?
  total       Int       @default(0)
  processed   Int       @default(0)
  succeeded   Int       @default(0)
  failed      Int       @default(0)
  skipped     Int       @default(0)
  message     String?
  createdAt   DateTime  @default(now())
  updatedAt   temporal.updatedAt()
  finishedAt  DateTime?

  @@index([kind, status])
  @@map("job_runs")
}

model ClinicClaim {
  id                  String   @id @default(uuid())
  clinicId            String
  clinic              Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorName          String
  phone               String
  email               String
  professionalCardUrl String?
  status              String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt           DateTime @default(now())
  updatedAt           temporal.updatedAt()

  @@map("clinic_claims")
}


model ClinicOtp {
  id          String    @id @default(uuid())
  email       String
  purpose     String    @default("LOGIN") // LOGIN
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  ip          String?
  createdAt   DateTime  @default(now())
  updatedAt   temporal.updatedAt()

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("clinic_otps")
}

model BlogPost {
  id                   String    @id @default(uuid())
  slug                 String    @unique
  titleFr              String
  titleAr              String
  excerptFr            String
  excerptAr            String
  contentFr            String
  contentAr            String
  categoryFr           String
  categoryAr           String
  readTime             Int       @default(5)
  coverImageUrl        String?
  relatedCitySlug      String?
  relatedSpecialtySlug String?
  status               String    @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt          DateTime?

  // Per-article SEO overrides. Any null field falls back to the article's own
  // title/excerpt when metadata is built.
  metaTitleFr          String?
  metaTitleAr          String?
  metaDescriptionFr    String?
  metaDescriptionAr    String?
  keywordsFr           String?
  keywordsAr           String?
  ogImageUrl           String?

  createdAt            DateTime  @default(now())
  updatedAt            temporal.updatedAt()

  @@index([status])
  @@index([relatedSpecialtySlug])
  @@index([relatedCitySlug])
  @@map("blog_posts")
}


model PageBlock {
  id          String   @id @default(uuid())
  routeKey    String
  locale      String
  blockKey    String
  title       String?
  subtitle    String?
  content     String?
  data        Json?
  createdAt   DateTime  @default(now())
  updatedAt   temporal.updatedAt()

  @@unique([routeKey, locale, blockKey])
  @@index([routeKey, locale])
  @@map("page_blocks")
}

model PageSeo {
  id              String   @id @default(uuid())
  routeKey        String
  locale          String
  metaTitle       String?
  metaDescription String?
  keywords        String?
  ogImageUrl      String?
  canonicalUrl    String?
  metaRobots      String?

  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAt()

  @@unique([routeKey, locale])
  @@map("page_seos")
}

model PricingPlan {
  id          String   @id @default(uuid())
  key         String   @unique
  active      Boolean  @default(true)
  highlighted Boolean  @default(false)
  sortOrder   Int      @default(0)
  leadType    String   // app-demo, website-quote, clinic-claim, contact
  nameFr      String
  nameAr      String
  priceFr     String
  priceAr     String
  periodFr    String
  periodAr    String
  ctaFr       String
  ctaAr       String
  badgeFr     String?
  badgeAr     String?
  featuresFr  Json
  featuresAr  Json
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@index([active, sortOrder])
  @@map("pricing_plans")
}

model KapsoAccount {
  id                String             @id @default(uuid())
  name              String
  phoneNumberId     String
  businessAccountId String?
  apiKey            String
  baseUrl           String             @default("https://app.kapso.ai/api/meta/")
  status            String             @default("INACTIVE") // ACTIVE, INACTIVE, ERROR
  isDefault         Boolean            @default(false)
  lastTestedAt      DateTime?
  testResult        Json?
  lastSyncedAt      DateTime?
  templates         WhatsAppTemplate[]
  createdAt         DateTime           @default(now())
  updatedAt         temporal.updatedAt()

  @@map("kapso_accounts")
}

model WhatsAppTemplate {
  id           String       @id @default(uuid())
  accountId    String
  account      KapsoAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId   String?
  name         String       // e.g. "dental_app_promo_fr"
  language     String       // e.g. "fr", "ar"
  category     String       @default("MARKETING") // MARKETING, UTILITY, AUTHENTICATION
  status       String       @default("APPROVED") // APPROVED, PENDING, REJECTED, PAUSED
  bodyText     String
  headerText   String?
  footerText   String?
  variables    Json         // Array of variable names in order: ["clinic_name", "city_name", "profile_url"]
  rawMeta      Json?
  lastSyncedAt DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    temporal.updatedAt()

  @@unique([accountId, name, language])
  @@index([status])
  @@map("whatsapp_templates")
}
